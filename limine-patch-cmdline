#!/usr/bin/env bash
# =============================================================================
# limine-patch-cmdline
# Reinyecta parámetros de kernel personalizados en /boot/limine.conf
# tras actualizaciones del sistema vía pacman hook.
#
# Instalación:
#   sudo cp limine-patch-cmdline /usr/local/bin/limine-patch-cmdline
#   sudo chmod +x /usr/local/bin/limine-patch-cmdline
#   sudo cp limine-cmdline-patch.hook /etc/pacman.d/hooks/limine-cmdline-patch.hook
# =============================================================================

set -euo pipefail

LIMINE_CONF="/boot/limine.conf"
CURRENT_ROOT_UUID="$(findmnt -no UUID / 2>/dev/null || true)"
WINDOWS_EFI_PATH=""
for candidate in \
    "/boot/EFI/Microsoft/Boot/bootmgfw.efi" \
    "/boot/efi/EFI/Microsoft/Boot/bootmgfw.efi" \
    "/efi/EFI/Microsoft/Boot/bootmgfw.efi"; do
    if [[ -f "$candidate" ]]; then
        WINDOWS_EFI_PATH="$candidate"
        break
    fi
done

# Parámetros que deben estar siempre presentes en cada línea CMDLINE.
# Agrega aquí cualquier otro parámetro que quieras proteger.
REQUIRED_PARAMS=(
    "usbcore.autosuspend=-1"
)

# Auto-detect hardware for GPU-specific parameters
if lspci | grep -qi "nvidia"; then
    echo "[limine-patch] NVIDIA GPU detected. Adding nvidia_drm optimizations."
    REQUIRED_PARAMS+=(
        "nvidia_drm.modeset=1"
        "nvidia_drm.fbdev=1"
    )
fi

if lspci | grep -qi "vga.*amd"; then
    echo "[limine-patch] AMD GPU detected. Adding amd_pstate parameter."
    REQUIRED_PARAMS+=(
        "amd_pstate=active"
    )
fi

[[ $EUID -ne 0 ]] && { echo "Ejecuta como root."; exit 1; }
[[ ! -f "$LIMINE_CONF" ]] && { echo "No se encontró $LIMINE_CONF"; exit 1; }

tmpfile=$(mktemp)
modified=0

while IFS= read -r line; do
    if echo "$line" | grep -qiE '^\s*(kernel_)?cmdline\s*[:=]'; then
        if [[ -n "$CURRENT_ROOT_UUID" ]] && echo "$line" | grep -qE 'root=UUID=[^[:space:]]+'; then
            line="$(echo "$line" | sed -E "s#root=UUID=[^[:space:]]+#root=UUID=${CURRENT_ROOT_UUID}#")"
            modified=1
            echo "[limine-patch] root=UUID actualizado a ${CURRENT_ROOT_UUID}" >&2
        fi
        for param in "${REQUIRED_PARAMS[@]}"; do
            if ! echo "$line" | grep -qF "$param"; then
                line="$line $param"
                echo "[limine-patch] Agregado: '$param'" >&2
                modified=1
            fi
        done
    fi
    echo "$line"
done < "$LIMINE_CONF" > "$tmpfile"

if [[ -n "$WINDOWS_EFI_PATH" ]] && ! grep -qiE '^\s*:\s*windows' "$tmpfile"; then
    windows_rel_path="${WINDOWS_EFI_PATH#/boot}"
    windows_rel_path="${windows_rel_path#/efi}"
    cat >> "$tmpfile" <<EOF

:Windows
    protocol: efi
    path: boot():${windows_rel_path}
EOF
    modified=1
    echo "[limine-patch] Entrada Windows agregada automáticamente (${windows_rel_path})" >&2
fi

if [[ $modified -eq 1 ]]; then
    cp "$LIMINE_CONF" "${LIMINE_CONF}.bak"
    mv "$tmpfile" "$LIMINE_CONF"
    echo "[limine-patch] limine.conf actualizado. Backup en ${LIMINE_CONF}.bak"
else
    rm -f "$tmpfile"
    echo "[limine-patch] Sin cambios necesarios."
fi
